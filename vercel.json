{
  "version": 2,
  "buildCommand": "echo 'No build needed for Node.js project'",
  "installCommand": "npm install --omit=dev",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/",
      "destination": "/api/webhook"
    },
    {
      "source": "/health",
      "destination": "/api/webhook"
    }
  ],
  "headers": [
    {
      "source": "/health",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
