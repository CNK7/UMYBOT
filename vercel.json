{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'No build step required'",
  "installCommand": "npm install --omit=dev",
  "outputDirectory": ".",
  "cleanUrls": false,
  "functions": {
    "api/webhook.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/webhook"
    }
  ]
}
