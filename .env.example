# ============================================
# Telegram Bot 配置文件
# 复制此文件为 .env 并填入实际值
# ============================================

# 机器人 Token（从 @BotFather 获取）
BOT_TOKEN=your_bot_token_here

# 管理员用户 ID（支持多个，用逗号分隔）
# 如何获取 ID：向 @userinfobot 发送任意消息
ADMIN_IDS=123456789,987654321

# 机器人用户名（不带 @，用于会员表情引用）
BOT_USERNAME=your_bot_username

# ============================================
# Webhook 配置（Vercel/aapanel 部署时需要）
# ============================================
# Webhook 模式开关：true=Webhook，false=长轮询（本地测试用）
USE_WEBHOOK=false

# Webhook URL（部署后的 HTTPS 地址 + /api/webhook 路径）
# ⚠️ Vercel 部署请用 /api/webhook 结尾！不是 /webhook！
# Vercel 示例：https://your-project.vercel.app/api/webhook
# aapanel 示例：https://your-domain.com/webhook
WEBHOOK_URL=

# 服务端口（aapanel 部署时使用）
PORT=3000

# ============================================
# 欢迎消息配置
# ============================================
# 欢迎消息标题
WELCOME_TITLE=你好

# 欢迎消息主内容
WELCOME_MESSAGE=专属会话已建立\n\n请直接发送需要咨询的文字、图片、文件或其他内容，客服人员收到后会尽快回复。

# 欢迎消息底部状态
WELCOME_STATUS=✅ 当前状态：在线接收\n🌐 会话通道：已连接\n🔔 消息通知：已开启

# 欢迎消息尾部制作者文字（最后一行，默认就是 🌍本机器人由悠米一手制作： @ummix）
WELCOME_FOOTER=🌍本机器人由悠米一手制作： @ummix

# 用户消息自动回复（可选，默认开启）
# 用户给机器人发任何消息后，1 分钟内最多自动回复一次这条内容
# 不想启用就填 false
AUTO_REPLY_ENABLED=true

# 自动回复内容（🤖 emoji 可以被 Premium 替换，见下 AUTO_REPLY_BOT_EMOJI_ID）
AUTO_REPLY_TEXT=悠米bot已接收您的消息，请耐心等待人工客服的回复。感谢您的理解与等待哦～

# 自动回复开头 🤖 的 Premium custom_emoji_id（可选，不填就显示普通 🤖）
AUTO_REPLY_BOT_EMOJI_ID=

# 欢迎消息图片 URL（可选，留空则不发送图片）
WELCOME_IMAGE_URL=

# 欢迎消息动画贴纸 File ID（可选，🐻 Sticker贴纸面板里的动态贴纸用这个）
# 获取方式：把动态贴纸（🐻那个图标面板里的）转发给 @RawDataBot → 找 "sticker.file_id" 字段（CAAC... 开头的长串）
# 留空则不发送动态贴纸
WELCOME_STICKER_ID=

# 欢迎消息 Premium 自定义表情 ID（可选，😀 Emoji 面板里的 Flags/V7 盾徽等会员表情用这个）
# 获取方式：把那个 Premium 自定义表情（比如你截图里的 Flags 那个 V7 盾牌，是 😀 面板里的，不是🐻面板里的）发给聊天
#          然后把整条消息转发给 @RawDataBot → 在返回的 JSON 里找 entities[].custom_emoji_id = "一长串数字" → 复制到这里
# 留空则标题前显示普通 emoji（由 WELCOME_PREMIUM_EMOJI_TEXT 控制）
WELCOME_PREMIUM_EMOJI_ID=
# 如果上面填了 Premium 表情，这里填一个「老客户端不支持Premium表情时的降级显示文字」，一般写一个emoji就好
WELCOME_PREMIUM_EMOJI_TEXT=✨

# ============================================
# 🎨 其他可替换的 Premium 自定义表情（可选，每一个都可以单独替换成 Premium 表情）
# ============================================
# （不填就用普通 emoji，填了就用 Premium 动效，和标题前的配置方式一样：custom_emoji_id|降级文字）
#
# 引用框左上角那个 🔒 锁头图标 → 替换成 Premium：
QUOTE_LOCK_EMOJI_ID=
#
# 💗请直接发送... 那行的 💗 爱心图标 → 替换成 Premium：
HEART_EMOJI_ID=
#
# 🌍本机器人由悠米一手制作 那行的 🌍 地球图标 → 替换成 Premium：
FOOTER_GLOBE_EMOJI_ID=
#
# 自动回复开头 🤖 那个机器人图标 → 替换成 Premium：
AUTO_REPLY_BOT_EMOJI_ID=
#
# 底部状态 ✅ 当前状态 那个对号图标 → 替换成 Premium：
STATUS_CHECK_EMOJI_ID=
#
# 底部状态 🌐 会话通道 那个地球图标 → 替换成 Premium：
STATUS_GLOBE_EMOJI_ID=
#
# 底部状态 🔔 消息通知 那个铃铛图标 → 替换成 Premium：
STATUS_BELL_EMOJI_ID=

# ============================================
# 🎨 表情自定义速查
# ============================================
# 欢迎消息里的普通表情 ✨🔒📱 等 → 修改：WELCOME_TITLE / WELCOME_MESSAGE / WELCOME_STATUS
#                                直接在值里加任何 Telegram 支持的 emoji 即可
# 按钮文字里的表情 📢🖼️📌     → 修改：INLINE_BUTTONS / BROADCAST_BUTTONS 的 text 字段
# 广播/回复消息里加表情       → 直接在 Telegram 聊天输入框里打 emoji/粘贴表情
# 动态/会员/超级表情（动画）→ 必须转发/用 file_id！不能手动输入！
#                             直接发给机器人或用「🎯 智能广播」，会原封不动保留动画效果
# 🐻 Sticker 贴纸面板动画    → 设置 WELCOME_STICKER_ID
# 😀 Emoji 面板 Premium 表情 → 设置 WELCOME_PREMIUM_EMOJI_ID（标题前）
# 单独替换 🔒/✅/🌐/🔔       → 设置上面的 QUOTE_LOCK_EMOJI_ID / STATUS_*_EMOJI_ID，或者直接在 ⚙️配置管理 菜单里改

# ============================================
# 自定义按钮配置（用 JSON 格式）
# ============================================
# 按钮配置示例：
# [{"text":"按钮1","url":"https://example.com"},{"text":"按钮2","callback_data":"action2"}]
# 说明：
#   - url 类型：点击跳转到网页
#   - callback_data 类型：点击触发回调（可自定义处理逻辑）
INLINE_BUTTONS=[{"text":"按钮","url":"https://example.com"},{"text":"按钮2","url":"https://example.com"}]

# ============================================
# 广播消息配置（管理员专用）
# ============================================
# 广播按钮（同样用 JSON 格式）
BROADCAST_BUTTONS=[{"text":"点击查看","url":"https://example.com"}]
